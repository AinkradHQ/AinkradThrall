# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 53
padding-literal 6
spacing-literal 2
radius-literal 0
hex-color 0
raw-color 2
raw-control 3
file-length 0
try-bang 0
force-cast 0
force-unwrap 0
print 0
opacity-literal 44
frame-literal 12
chamfer-literal 0
motion-literal 0
